# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored -- never commit real values.

aws_region   = "us-east-1"
environment  = "lab"
project_name = "modules-lab"

# VPC configuration
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.101.0/24", "10.0.102.0/24"]

# EC2 configuration
instance_type = "t3.micro"

# Find the latest Amazon Linux 2023 AMI:
#   aws ec2 describe-images \
#     --owners amazon \
#     --filters "Name=name,Values=al2023-ami-2023.*-x86_64" \
#     --query "Images | sort_by(@, &CreationDate) | [-1].ImageId" \
#     --output text
instance_ami = "ami-0123456789abcdef0"

# SSH key pair (must exist in the target region)
# Set to null or omit to skip SSH access
key_name = "my-keypair"

# Restrict SSH to your IP for security
# Find your IP: curl -s https://checkip.amazonaws.com
allowed_ssh_cidrs = ["203.0.113.0/32"]
